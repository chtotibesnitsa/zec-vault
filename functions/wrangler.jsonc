{
  // Deployed from the Cloudflare dashboard: Workers & Pages -> Import a repository,
  // root directory "functions". Secrets are set in the dashboard, never here.
  "name": "zec-vault-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": { "bindings": [{ "name": "VAULT", "class_name": "Vault" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Vault"] }],
  "observability": { "enabled": true },
  // Plain settings only. TOKEN_MINT is added on launch day.
  "vars": {
    "TOKEN_SYMBOL": "ZATS",
    "BRAND_NAME": "Zatoshi",
    "CLAIM_EVERY_MINUTES": "5",
    "REWARD_SHARE_BPS": "8000",
    "BURN_BPS": "2000",
    "MIN_HOLD_TOKENS": "100000",
    "SITE_URL": "https://zec-vault.vercel.app"
  }
}
